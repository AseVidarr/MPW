Data/
*.db
*.db-wal
*.db-shm
logs/
app_configuration.json

# Editors / operating systems
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

# Claude Code: personal local settings
.claude/settings.local.json
