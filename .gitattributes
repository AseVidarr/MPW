# Normalise line endings in the repository; check out each file type the way its system needs it.
* text=auto

# Unix: Windows line endings would stop these from running on macOS/Linux
*.sh       text eol=lf
*.command  text eol=lf
*.py       text eol=lf
*.yml      text eol=lf
*.spec     text eol=lf

# Windows scripts and installer
*.ps1      text eol=crlf
*.cmd      text eol=crlf
*.iss      text eol=crlf

# Binary files
*.sqlite   binary
*.ico      binary
*.png      binary
*.jpg      binary
